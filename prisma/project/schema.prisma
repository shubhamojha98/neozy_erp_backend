generator client {
  provider = "prisma-client"
  output   = "../../generated/project"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"

  schemas = ["project"]
}

// ============================================================
// PROJECT (B2C solar installation) — stage haath wale workflow ke order me:
// Survey → Engineering → Quotation → (Loan) → Registration → Invoice → Order
// → Dispatch → Installation → QC → Commissioning → Net Metering → Subsidy → Handover
// ============================================================
enum ProjectStage {
  SURVEY
  ENGINEERING
  QUOTATION
  LOAN // sirf Bank Loan wale project me
  REGISTRATION
  INVOICE
  ORDER
  DISPATCH
  INSTALLATION
  QC
  COMMISSIONING
  NET_METERING
  SUBSIDY
  HANDOVER

  @@schema("project")
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED

  @@schema("project")
}

enum PaymentMode {
  CASH
  LOAN

  @@schema("project")
}

enum SurveyStatus {
  SCHEDULED
  COMPLETED
  CANCELLED

  @@schema("project")
}

enum EngineeringStatus {
  DRAFT
  APPROVED

  @@schema("project")
}

enum ProjectActivityType {
  CREATED
  UPDATED
  STAGE
  SURVEY
  ENGINEERING
  NOTE

  @@schema("project")
}

// ============================================================
// CUSTOMER — B2B (trading / material buyer) ya B2C (solar installation)
// companyId / assignedTo / createdBy → panel DB ke ids
// ============================================================
enum CustomerType {
  B2B
  B2C

  @@schema("project")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE

  @@schema("project")
}

model Customer {
  id           Int            @id @default(autoincrement())
  companyId    Int
  customerCode String // CUS000001 (company me unique)
  type         CustomerType
  status       CustomerStatus @default(ACTIVE)

  name           String // B2C: customer, B2B: contact person
  phone          String
  alternatePhone String?
  email          String?
  address        String? // B2B: office address, B2C: installation address
  city           String?
  state          String?
  pincode        String?

  // B2B
  companyName  String?
  gstin        String?
  industryType String?

  // B2C (solar)
  aadhaarNumber  String?
  projectType    String? // Residential / Commercial / Industrial / Agricultural
  monthlyBill    Decimal? @db.Decimal(12, 2)
  sanctionLoadKw Decimal? @db.Decimal(10, 2)
  consumerNumber String?
  roofType       String?

  source       String? // lead ka source (Website, Referral, ...) ya "Direct"
  assignedTo   Int? // user id
  sourceLeadId Int? // lead.Lead.id
  notes        String?

  createdBy Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  projects Project[]

  @@unique([companyId, customerCode])
  @@index([companyId, phone])
  @@index([companyId, type])
  @@index([assignedTo])
  @@schema("project")
}

model Project {
  id          Int      @id @default(autoincrement())
  companyId   Int
  projectCode String // PRJ000001 (company me unique)
  customerId  Int
  customer    Customer @relation(fields: [customerId], references: [id])

  capacityKw  Decimal       @db.Decimal(10, 2) // planned kW (engineering ke baad final)
  projectType String // Residential / Commercial / Industrial / Agricultural
  stage       ProjectStage  @default(SURVEY)
  status      ProjectStatus @default(ACTIVE)
  paymentMode PaymentMode? // quotation ke baad: Cash ya Bank Loan

  assignedTo  Int? // project owner (user id)
  surveyorId  Int?
  installerId Int?

  // Site address (default: customer ka installation address)
  address  String?
  landmark String?
  city     String?
  state    String?
  pincode  String?
  notes    String?

  createdBy Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  surveys     Survey[]
  engineering EngineeringDesign?
  activities  ProjectActivity[]

  @@unique([companyId, projectCode])
  @@index([companyId, stage])
  @@index([customerId])
  @@index([assignedTo])
  @@schema("project")
}

// Site survey — schedule → report bhar ke complete (photos Documents me "Site Photo")
model Survey {
  id        Int     @id @default(autoincrement())
  companyId Int
  projectId Int
  project   Project @relation(fields: [projectId], references: [id])

  surveyorId  Int
  scheduledAt DateTime
  status      SurveyStatus @default(SCHEDULED)

  // Report
  roofType           String?
  roofAreaSqft       Decimal? @db.Decimal(10, 2)
  shadowFreeAreaSqft Decimal? @db.Decimal(10, 2)
  meterPhase         String? // Single Phase / Three Phase
  sanctionLoadKw     Decimal? @db.Decimal(10, 2)
  recommendedKw      Decimal? @db.Decimal(10, 2)
  shadingNotes       String?
  structureNotes     String?
  latitude           Decimal? @db.Decimal(9, 6)
  longitude          Decimal? @db.Decimal(9, 6)
  remarks            String?
  completedAt        DateTime?
  completedBy        Int?
  cancelReason       String?

  createdBy Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([surveyorId])
  @@schema("project")
}

// Engineering design — ek project ka ek design (drawings Documents me)
model EngineeringDesign {
  id        Int     @id @default(autoincrement())
  companyId Int
  projectId Int     @unique
  project   Project @relation(fields: [projectId], references: [id])

  panelBrand    String?
  panelWattage  Int // W per panel
  panelCount    Int
  systemKw      Decimal @db.Decimal(10, 2) // panelCount × panelWattage / 1000
  inverterBrand String?
  inverterKw    Decimal @db.Decimal(10, 2)
  structureType String? // Elevated / Flush Mount / Ground Mount
  notes         String?

  status     EngineeringStatus @default(DRAFT)
  approvedBy Int?
  approvedAt DateTime?

  createdBy Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("project")
}

// Project timeline — har kaam ka record
model ProjectActivity {
  id        Int                 @id @default(autoincrement())
  projectId Int
  project   Project             @relation(fields: [projectId], references: [id])
  type      ProjectActivityType
  message   String
  createdBy Int
  createdAt DateTime            @default(now())

  @@index([projectId])
  @@schema("project")
}

// ============================================================
// DOCUMENT — Lead / Customer / Project ki files (ek hi table, sab jagah wahi record)
// File disk par: uploads/{companyId}/{yyyy-mm}/{category}/{random}.jpg
// leadId → lead.Lead.id (dusra DB). Convert par customerId bhi lag jata hai.
// ============================================================
model Document {
  id         Int     @id @default(autoincrement())
  companyId  Int
  leadId     Int?
  customerId Int?
  projectId  Int?
  category   String // Aadhaar, Electricity Bill, ...
  fileName   String // user ki file ka asli naam
  filePath   String // uploads/... (relative)
  mimeType   String
  size       Int // bytes (compress ke baad)

  uploadedBy Int
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([companyId, leadId])
  @@index([companyId, customerId])
  @@index([companyId, projectId])
  @@schema("project")
}
