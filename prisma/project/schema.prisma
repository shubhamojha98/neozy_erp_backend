generator client {
  provider = "prisma-client"
  output   = "../../generated/project"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"

  schemas = ["project"]
}

// ============================================================
// PROJECT (B2C solar installation) — stage haath wale workflow ke order me:
// Survey → Engineering → Quotation → (Loan) → Registration → Invoice → Order
// → Dispatch → Installation → QC → Commissioning → Net Metering → Subsidy → Handover
// ============================================================
enum ProjectStage {
  SURVEY
  ENGINEERING
  QUOTATION
  LOAN // sirf Bank Loan wale project me
  REGISTRATION
  INVOICE
  ORDER
  DISPATCH
  INSTALLATION
  QC
  COMMISSIONING
  NET_METERING
  SUBSIDY
  HANDOVER

  @@schema("project")
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED

  @@schema("project")
}

enum PaymentMode {
  CASH
  LOAN

  @@schema("project")
}

enum SurveyStatus {
  SCHEDULED
  COMPLETED
  CANCELLED

  @@schema("project")
}

enum EngineeringStatus {
  DRAFT
  APPROVED

  @@schema("project")
}

enum ProjectActivityType {
  CREATED
  UPDATED
  STAGE
  SURVEY
  ENGINEERING
  QUOTATION
  LOAN
  REGISTRATION
  INVOICE
  PAYMENT
  ORDER
  DISPATCH
  INSTALLATION
  QC
  COMMISSIONING
  NET_METERING
  SUBSIDY
  HANDOVER
  NOTE

  @@schema("project")
}

// B2B sales order: Quotation / Invoice → Order (100% advance) → Dispatch → Close
enum SalesOrderStage {
  QUOTATION
  INVOICE
  ORDER
  DISPATCH

  @@schema("project")
}

enum SalesOrderStatus {
  OPEN
  CLOSED
  CANCELLED

  @@schema("project")
}

enum DispatchStatus {
  DISPATCHED
  DELIVERED

  @@schema("project")
}

enum SerialType {
  PANEL
  INVERTER

  @@schema("project")
}

enum InstallationStatus {
  SCHEDULED
  COMPLETED

  @@schema("project")
}

enum QcStatus {
  PASSED
  FAILED

  @@schema("project")
}

enum NetMeteringStatus {
  SUBMITTED
  METER_INSTALLED
  REJECTED

  @@schema("project")
}

enum SubsidyStatus {
  SUBMITTED
  DISBURSED
  REJECTED
  NOT_APPLICABLE // customer eligible nahi / subsidy nahi chahiye

  @@schema("project")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED

  @@schema("project")
}

enum LoanStatus {
  APPLIED
  SANCTIONED
  REJECTED

  @@schema("project")
}

enum RegistrationStatus {
  SUBMITTED
  APPROVED
  REJECTED

  @@schema("project")
}

enum PaymentMethod {
  CASH
  UPI
  CHEQUE
  BANK_TRANSFER
  LOAN // bank loan disbursement

  @@schema("project")
}

// ============================================================
// CUSTOMER — B2B (trading / material buyer) ya B2C (solar installation)
// companyId / assignedTo / createdBy → panel DB ke ids
// ============================================================
enum CustomerType {
  B2B
  B2C

  @@schema("project")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE

  @@schema("project")
}

model Customer {
  id           Int            @id @default(autoincrement())
  companyId    Int
  customerCode String // CUS000001 (company me unique)
  type         CustomerType
  status       CustomerStatus @default(ACTIVE)

  name           String // B2C: customer, B2B: contact person
  phone          String
  alternatePhone String?
  email          String?
  address        String? // B2B: office address, B2C: installation address
  city           String?
  state          String?
  pincode        String?

  // B2B
  companyName  String?
  gstin        String?
  industryType String?

  // B2C (solar)
  aadhaarNumber  String?
  projectType    String? // Residential / Commercial / Industrial / Agricultural
  monthlyBill    Decimal? @db.Decimal(12, 2)
  sanctionLoadKw Decimal? @db.Decimal(10, 2)
  consumerNumber String?
  roofType       String?

  source       String? // lead ka source (Website, Referral, ...) ya "Direct"
  assignedTo   Int? // user id
  sourceLeadId Int? // lead.Lead.id
  notes        String?

  createdBy Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  projects    Project[]
  salesOrders SalesOrder[]

  @@unique([companyId, customerCode])
  @@index([companyId, phone])
  @@index([companyId, type])
  @@index([assignedTo])
  @@schema("project")
}

model Project {
  id          Int      @id @default(autoincrement())
  companyId   Int
  projectCode String // PRJ000001 (company me unique)
  customerId  Int
  customer    Customer @relation(fields: [customerId], references: [id])

  capacityKw  Decimal       @db.Decimal(10, 2) // planned kW (engineering ke baad final)
  projectType String // Residential / Commercial / Industrial / Agricultural
  stage       ProjectStage  @default(SURVEY)
  status      ProjectStatus @default(ACTIVE)
  paymentMode   PaymentMode? // quotation accept par: Cash ya Bank Loan
  contractValue Decimal?     @db.Decimal(14, 2) // accepted quotation ka total (payment % isi par)

  assignedTo  Int? // project owner (user id)
  surveyorId  Int?
  installerId Int?

  // Site address (default: customer ka installation address)
  address  String?
  landmark String?
  city     String?
  state    String?
  pincode  String?
  notes    String?

  createdBy Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  surveys      Survey[]
  engineering  EngineeringDesign?
  quotations   Quotation[]
  loan         LoanApplication?
  registration Registration?
  invoice      Invoice?
  payments     Payment[]
  order         ProjectOrder?
  dispatch      Dispatch?
  serials       EquipmentSerial[]
  installation  Installation?
  qualityChecks QualityCheck[]
  commissioning Commissioning?
  netMetering   NetMetering?
  subsidy       Subsidy?
  handover      Handover?
  activities    ProjectActivity[]

  @@unique([companyId, projectCode])
  @@index([companyId, stage])
  @@index([customerId])
  @@index([assignedTo])
  @@schema("project")
}

// Site survey — schedule → report bhar ke complete (photos Documents me "Site Photo")
model Survey {
  id        Int     @id @default(autoincrement())
  companyId Int
  projectId Int
  project   Project @relation(fields: [projectId], references: [id])

  surveyorId  Int
  scheduledAt DateTime
  status      SurveyStatus @default(SCHEDULED)

  // Report
  roofType           String?
  roofAreaSqft       Decimal? @db.Decimal(10, 2)
  shadowFreeAreaSqft Decimal? @db.Decimal(10, 2)
  meterPhase         String? // Single Phase / Three Phase
  sanctionLoadKw     Decimal? @db.Decimal(10, 2)
  recommendedKw      Decimal? @db.Decimal(10, 2)
  shadingNotes       String?
  structureNotes     String?
  latitude           Decimal? @db.Decimal(9, 6)
  longitude          Decimal? @db.Decimal(9, 6)
  remarks            String?
  completedAt        DateTime?
  completedBy        Int?
  cancelReason       String?

  createdBy Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([surveyorId])
  @@schema("project")
}

// Engineering design — ek project ka ek design (drawings Documents me)
model EngineeringDesign {
  id        Int     @id @default(autoincrement())
  companyId Int
  projectId Int     @unique
  project   Project @relation(fields: [projectId], references: [id])

  panelBrand    String?
  panelWattage  Int // W per panel
  panelCount    Int
  systemKw      Decimal @db.Decimal(10, 2) // panelCount × panelWattage / 1000
  inverterBrand String?
  inverterKw    Decimal @db.Decimal(10, 2)
  structureType String? // Elevated / Flush Mount / Ground Mount
  notes         String?

  status     EngineeringStatus @default(DRAFT)
  approvedBy Int?
  approvedAt DateTime?

  createdBy Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("project")
}

// Quotation — item lines + charges. ACCEPTED hone ke baad lock (invoice isi se banta hai)
model Quotation {
  id           Int         @id @default(autoincrement())
  companyId    Int
  projectId    Int? // B2C project ki
  project      Project?    @relation(fields: [projectId], references: [id])
  salesOrderId Int? // ya B2B sales order ki
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])
  quotationNo String // QT000001 (company me unique)

  date             DateTime  @db.Date
  validUntil       DateTime? @db.Date
  deliveryTimeline String?
  notes            String?

  subtotal            Decimal @db.Decimal(14, 2)
  taxTotal            Decimal @db.Decimal(14, 2)
  installationCharges Decimal @default(0) @db.Decimal(14, 2)
  transportCharges    Decimal @default(0) @db.Decimal(14, 2)
  discount            Decimal @default(0) @db.Decimal(14, 2)
  total               Decimal @db.Decimal(14, 2)

  status    QuotationStatus @default(DRAFT)
  createdBy Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  items   QuotationItem[]
  invoice Invoice?

  @@unique([companyId, quotationNo])
  @@index([projectId])
  @@index([salesOrderId])
  @@schema("project")
}

model QuotationItem {
  id          Int       @id @default(autoincrement())
  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   Int? // inventory product (optional)
  name        String
  description String?
  hsn         String?
  unit        String    @default("Nos")
  qty         Decimal   @db.Decimal(12, 2)
  rate        Decimal   @db.Decimal(14, 2) // GST se pehle, per unit
  gstRate     Decimal   @db.Decimal(5, 2) // %
  sortOrder   Int       @default(0)

  @@index([quotationId])
  @@schema("project")
}

// Bank loan — sirf LOAN wale project me. SANCTIONED → Registration
model LoanApplication {
  id               Int        @id @default(autoincrement())
  companyId        Int
  projectId        Int        @unique
  project          Project    @relation(fields: [projectId], references: [id])
  bankName         String
  branch           String?
  applicationNo    String?
  loanAmount       Decimal    @db.Decimal(14, 2)
  status           LoanStatus @default(APPLIED)
  sanctionedAmount Decimal?   @db.Decimal(14, 2)
  sanctionDate     DateTime?  @db.Date
  rejectReason     String?
  notes            String?
  createdBy        Int
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@schema("project")
}

// Portal / scheme registration (PM Surya Ghar, DISCOM ...). APPROVED → Invoice
model Registration {
  id               Int                @id @default(autoincrement())
  companyId        Int
  projectId        Int                @unique
  project          Project            @relation(fields: [projectId], references: [id])
  portal           String
  discom           String?
  applicationNo    String
  registrationDate DateTime           @db.Date
  status           RegistrationStatus @default(SUBMITTED)
  rejectReason     String?
  notes            String?
  createdBy        Int
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@schema("project")
}

// Invoice — accepted quotation se (items wahi). Ek project ka ek invoice.
model Invoice {
  id           Int         @id @default(autoincrement())
  companyId    Int
  projectId    Int?        @unique
  project      Project?    @relation(fields: [projectId], references: [id])
  salesOrderId Int?        @unique
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])
  quotationId Int       @unique
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  invoiceNo   String // INV000001 (company me unique)
  date        DateTime  @db.Date
  total       Decimal   @db.Decimal(14, 2)
  createdBy   Int
  createdAt   DateTime  @default(now())

  @@unique([companyId, invoiceNo])
  @@schema("project")
}

// Customer se aaya paisa (loan disbursement bhi). Order ke liye 90% zaroori.
model Payment {
  id           Int           @id @default(autoincrement())
  companyId    Int
  projectId    Int?
  project      Project?      @relation(fields: [projectId], references: [id])
  salesOrderId Int?
  salesOrder   SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod
  paidOn    DateTime      @db.Date
  reference String? // UTR / cheque no.
  notes     String?
  createdBy Int
  createdAt DateTime      @default(now())
  deletedAt DateTime?

  @@index([projectId])
  @@index([salesOrderId])
  @@schema("project")
}

// Order — 90% payment ke baad hi. Iske baad Dispatch.
model ProjectOrder {
  id          Int      @id @default(autoincrement())
  companyId   Int
  projectId   Int      @unique
  project     Project  @relation(fields: [projectId], references: [id])
  orderNo     String // ORD000001 (company me unique)
  date        DateTime @db.Date
  paidPercent Decimal  @db.Decimal(5, 2) // order bante waqt kitna paid tha
  createdBy   Int
  createdAt   DateTime @default(now())

  @@unique([companyId, orderNo])
  @@schema("project")
}

// Dispatch — material site par bheja. DELIVERED → Installation
model Dispatch {
  id           Int            @id @default(autoincrement())
  companyId    Int
  projectId    Int?           @unique
  project      Project?       @relation(fields: [projectId], references: [id])
  salesOrderId Int?           @unique
  salesOrder   SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  dispatchNo   String // DSP000001 (company me unique)
  dispatchDate DateTime       @db.Date
  vehicleNo    String
  driverName   String?
  driverPhone  String?
  lrNumber     String?
  notes        String?
  status       DispatchStatus @default(DISPATCHED)
  deliveredAt  DateTime?
  receivedBy   String? // site par kisne liya
  createdBy    Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([companyId, dispatchNo])
  @@schema("project")
}

// Panel / inverter serial — Dispatch par, warna Installation / QC par
model EquipmentSerial {
  id        Int          @id @default(autoincrement())
  companyId Int
  projectId Int
  project   Project      @relation(fields: [projectId], references: [id])
  type      SerialType
  serialNo  String
  stage     ProjectStage // kis stage par record hua
  createdBy Int
  createdAt DateTime     @default(now())

  @@unique([companyId, serialNo])
  @@index([projectId])
  @@schema("project")
}

// Installation — installer + date → complete (stage QC)
model Installation {
  id            Int                @id @default(autoincrement())
  companyId     Int
  projectId     Int                @unique
  project       Project            @relation(fields: [projectId], references: [id])
  installerId   Int
  scheduledDate DateTime           @db.Date
  status        InstallationStatus @default(SCHEDULED)
  completedAt   DateTime?
  notes         String?
  createdBy     Int
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@schema("project")
}

// QC — har attempt ek record (fail → dobara). items = [{ item, passed }]
model QualityCheck {
  id        Int      @id @default(autoincrement())
  companyId Int
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  items     Json
  status    QcStatus
  remarks   String?
  checkedBy Int
  checkedAt DateTime @default(now())

  @@index([projectId])
  @@schema("project")
}

// Commissioning — system chalu, generation test, warranty
model Commissioning {
  id             Int      @id @default(autoincrement())
  companyId      Int
  projectId      Int      @unique
  project        Project  @relation(fields: [projectId], references: [id])
  commissionedOn DateTime @db.Date
  generationKwh  Decimal  @db.Decimal(10, 2)
  warrantyStart  DateTime @db.Date
  warrantyMonths Int
  notes          String?
  createdBy      Int
  createdAt      DateTime @default(now())

  @@schema("project")
}

// Net metering — DISCOM application → meter installed (aage Subsidy sirf 100% payment par)
model NetMetering {
  id            Int               @id @default(autoincrement())
  companyId     Int
  projectId     Int               @unique
  project       Project           @relation(fields: [projectId], references: [id])
  discom        String
  applicationNo String
  submittedOn   DateTime          @db.Date
  status        NetMeteringStatus @default(SUBMITTED)
  meterNo       String?
  installedOn   DateTime?         @db.Date
  rejectReason  String?
  notes         String?
  createdBy     Int
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@schema("project")
}

// Subsidy — apply → disbursed (Handover) | rejected | not applicable (Handover)
model Subsidy {
  id              Int           @id @default(autoincrement())
  companyId       Int
  projectId       Int           @unique
  project         Project       @relation(fields: [projectId], references: [id])
  scheme          String
  applicationNo   String?
  amount          Decimal?      @db.Decimal(14, 2)
  appliedOn       DateTime?     @db.Date
  status          SubsidyStatus @default(SUBMITTED)
  disbursedAmount Decimal?      @db.Decimal(14, 2)
  disbursedOn     DateTime?     @db.Date
  rejectReason    String?
  notes           String?
  createdBy       Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@schema("project")
}

// Handover — customer ko system saunpa, project COMPLETED
model Handover {
  id           Int      @id @default(autoincrement())
  companyId    Int
  projectId    Int      @unique
  project      Project  @relation(fields: [projectId], references: [id])
  handoverDate DateTime @db.Date
  receivedBy   String // customer / family member ka naam
  notes        String?
  createdBy    Int
  createdAt    DateTime @default(now())

  @@schema("project")
}

// B2B sales order (material / trading customer). Quotation, Invoice, Payment, Dispatch B2C wali tables hi.
model SalesOrder {
  id            Int              @id @default(autoincrement())
  companyId     Int
  orderNo       String // SO000001 (company me unique)
  customerId    Int
  customer      Customer         @relation(fields: [customerId], references: [id])
  stage         SalesOrderStage  @default(QUOTATION)
  status        SalesOrderStatus @default(OPEN)
  contractValue Decimal?         @db.Decimal(14, 2) // accepted quotation / invoice ka total
  confirmedAt   DateTime? // 100% payment ke baad order confirm
  closedAt      DateTime?
  assignedTo    Int?
  notes         String?
  createdBy     Int
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  quotations Quotation[]
  invoice    Invoice?
  payments   Payment[]
  dispatch   Dispatch?
  activities ProjectActivity[]

  @@unique([companyId, orderNo])
  @@index([companyId, stage])
  @@index([customerId])
  @@schema("project")
}

// Project timeline — har kaam ka record
model ProjectActivity {
  id           Int                 @id @default(autoincrement())
  projectId    Int?
  project      Project?            @relation(fields: [projectId], references: [id])
  salesOrderId Int? // B2B sales order ki timeline
  salesOrder   SalesOrder?         @relation(fields: [salesOrderId], references: [id])
  type      ProjectActivityType
  message   String
  createdBy Int
  createdAt DateTime            @default(now())

  @@index([projectId])
  @@index([salesOrderId])
  @@schema("project")
}

// ============================================================
// DOCUMENT — Lead / Customer / Project ki files (ek hi table, sab jagah wahi record)
// File disk par: uploads/{companyId}/{yyyy-mm}/{category}/{random}.jpg
// leadId → lead.Lead.id (dusra DB). Convert par customerId bhi lag jata hai.
// ============================================================
model Document {
  id         Int     @id @default(autoincrement())
  companyId  Int
  leadId     Int?
  customerId Int?
  projectId  Int?
  salesOrderId Int? // B2B order (PO, challan, delivery proof)
  category   String // Aadhaar, Electricity Bill, ...
  fileName   String // user ki file ka asli naam
  filePath   String // uploads/... (relative)
  mimeType   String
  size       Int // bytes (compress ke baad)

  uploadedBy Int
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([companyId, leadId])
  @@index([companyId, customerId])
  @@index([companyId, projectId])
  @@index([companyId, salesOrderId])
  @@schema("project")
}
