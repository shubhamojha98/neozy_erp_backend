generator client {
  provider = "prisma-client"
  output   = "../../generated/project"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"

  schemas = ["project"]
}

enum ProjectStage {
  QUOTATION
  SURVEY
  SERVICE
  HANDOVER
  SUBSIDY
  NET_METERING

  @@schema("project")
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVED

  @@schema("project")
}

enum SurveyStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("project")
}

enum EngineeringStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@schema("project")
}

// ============================================================
// CUSTOMER — B2B (trading / material buyer) ya B2C (solar installation)
// companyId / assignedTo / createdBy → panel DB ke ids
// ============================================================
enum CustomerType {
  B2B
  B2C

  @@schema("project")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE

  @@schema("project")
}

model Customer {
  id           Int            @id @default(autoincrement())
  companyId    Int
  customerCode String // CUS000001 (company me unique)
  type         CustomerType
  status       CustomerStatus @default(ACTIVE)

  name           String // B2C: customer, B2B: contact person
  phone          String
  alternatePhone String?
  email          String?
  address        String? // B2B: office address, B2C: installation address
  city           String?
  state          String?
  pincode        String?

  // B2B
  companyName  String?
  gstin        String?
  industryType String?

  // B2C (solar)
  aadhaarNumber  String?
  projectType    String? // Residential / Commercial / Industrial / Agricultural
  monthlyBill    Decimal? @db.Decimal(12, 2)
  sanctionLoadKw Decimal? @db.Decimal(10, 2)
  consumerNumber String?
  roofType       String?

  source       String? // lead ka source (Website, Referral, ...) ya "Direct"
  assignedTo   Int? // user id
  sourceLeadId Int? // lead.Lead.id
  notes        String?

  createdBy Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  projects Project[]

  @@unique([companyId, customerCode])
  @@index([companyId, phone])
  @@index([companyId, type])
  @@index([assignedTo])
  @@schema("project")
}

model Project {
  id          Int      @id @default(autoincrement())
  companyId   Int
  projectCode String   @unique
  customerId  Int
  customer    Customer @relation(fields: [customerId], references: [id])

  leadId         String?
  capacityKw     Decimal       @db.Decimal(10, 2)
  projectType    String
  stage          ProjectStage  @default(QUOTATION)
  status         ProjectStatus @default(ACTIVE)
  salesOwnerId   Int?
  salesOwnerName String?
  surveyorId     Int?
  surveyorName   String?
  installerId    Int?
  installerName  String?
  managerId      Int?
  managerName    String?
  addressLine1   String?
  addressLine2   String?
  landmark       String?
  city           String?
  district       String?
  state          String?
  pincode        String?
  country        String        @default("India")
  notes          String?
  groupId        String?
  createdBy      Int
  createdAt      DateTime      @default(now())
  updatedBy      Int?
  updatedAt      DateTime      @updatedAt
  recStatus      Int           @default(1)

  surveys Survey[]

  @@index([customerId])
  @@index([stage])
  @@index([status])
  @@index([salesOwnerId])
  @@index([surveyorId])
  @@index([installerId])
  @@index([managerId])
  @@index([createdAt])
  @@schema("project")
}

model Survey {
  id        Int     @id @default(autoincrement())
  companyId Int
  surveyId  String  @unique
  projectId Int
  project   Project @relation(fields: [projectId], references: [id])

  scheduledDate DateTime?
  surveyorId    Int?
  status        SurveyStatus @default(PENDING)
  notes         String?

  // Engineering can be added later
  engineering EngineeringDesign?

  groupId String?

  createdAt DateTime @default(now())
  createdBy Int
  updatedAt DateTime @updatedAt
  updatedBy Int?
  recStatus Int      @default(1)

  @@index([projectId])
  @@index([status])
  @@schema("project")
}

model EngineeringDesign {
  id         Int               @id @default(autoincrement())
  companyId  Int
  designId   String            @unique
  // Engineering belongs to a Survey
  surveyId   Int               @unique
  // Keep projectId if you frequently query engineering by project
  //   projectId Int
  capacityKw Decimal?          @db.Decimal(10, 2)
  designerId Int?
  status     EngineeringStatus @default(PENDING)

  groupId   String?
  createdBy Int
  createdAt DateTime @default(now())
  updatedBy Int?
  updatedAt DateTime @updatedAt
  recStatus Int      @default(1)

  survey Survey @relation(fields: [surveyId], references: [id])
  //    project   Project @relation(fields: [projectId], references: [id])

  @@index([surveyId])
  //   @@index([projectId])
  @@index([status])
  @@schema("project")
}

// ============================================================
// DOCUMENT — Lead / Customer / Project ki files (ek hi table, sab jagah wahi record)
// File disk par: uploads/{companyId}/{yyyy-mm}/{category}/{random}.jpg
// leadId → lead.Lead.id (dusra DB). Convert par customerId bhi lag jata hai.
// ============================================================
model Document {
  id         Int     @id @default(autoincrement())
  companyId  Int
  leadId     Int?
  customerId Int?
  projectId  Int?
  category   String // Aadhaar, Electricity Bill, ...
  fileName   String // user ki file ka asli naam
  filePath   String // uploads/... (relative)
  mimeType   String
  size       Int // bytes (compress ke baad)

  uploadedBy Int
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([companyId, leadId])
  @@index([companyId, customerId])
  @@index([companyId, projectId])
  @@schema("project")
}
