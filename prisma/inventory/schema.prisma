generator client {
  provider = "prisma-client"
  output   = "../../generated/inventory"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"

  // schemas = ["inventory"]
}

// ======================================================
// PRODUCT CATEGORY
// ======================================================

model ProductCategory {
  id           Int     @id @default(autoincrement())
  companyId    Int
  categoryName String
  code         String?
  description  String?
  isActive     Boolean @default(true)

  createdAt DateTime? @default(now()) @db.Timestamptz
  createdBy String
  groupId   String?
  updatedAt DateTime? @updatedAt @db.Timestamptz
  updatedBy String?
  recStatus Int       @default(1)

  products Product[]

  @@map("product_categories")
  // @@schema("inventory")
}

// ======================================================
// PRODUCT
// ======================================================

model Product {
  id           BigInt   @id @default(autoincrement())
  companyId    Int
  productName  String
  sku          String
  unit         String
  hsn          String
  productPrice Decimal  @db.Decimal(15, 2)
  gstRate      Decimal  @db.Decimal(5, 2)
  categoryId   Int
  description  String?
  photo        String?
  status       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz
  createdBy    String
  groupId      String?

  updatedAt DateTime? @updatedAt @db.Timestamptz
  updatedBy String?

  recStatus Int @default(1)

  categoryMaster ProductCategory? @relation(fields: [categoryId], references: [id])

  stocks Stock[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([categoryId])
  @@index([productName])
  @@index([sku])
  @@map("products")
  // @@schema("inventory")
}

// ======================================================
// WAREHOUSE
// ======================================================

model Warehouse {
  id                Int       @id @default(autoincrement())
  companyId         Int
  warehouseName     String
  warehouseLocation String
  capacity          Decimal   @db.Decimal(15, 2)
  address           String?
  city              String?
  state             String?
  pincode           String?
  code              String?
  latitude          Decimal?  @db.Decimal(10, 7)
  longitude         Decimal?  @db.Decimal(10, 7)
  managerName       String?
  managerPhone      String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now()) @db.Timestamptz
  createdBy         String
  groupId           String?
  updatedAt         DateTime? @updatedAt @db.Timestamptz
  updatedBy         String?

  recStatus Int @default(1)

  // Relations
  stocks Stock[]

  @@index([companyId])
  @@index([warehouseName])
  @@index([warehouseLocation])
  @@map("warehouses")
  // @@schema("inventory")
}

// ======================================================
// STOCK
// ======================================================

model Stock {
  id        Int @id @default(autoincrement())
  companyId Int

  productId   BigInt
  warehouseId Int

  availableQty Decimal @default(0) @db.Decimal(15, 3)
  reservedQty  Decimal @default(0) @db.Decimal(15, 3)

  createdAt DateTime @default(now())
  createdBy String

  updatedAt DateTime? @updatedAt
  updatedBy String?

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([companyId])
  @@index([productId])
  @@index([warehouseId])
  @@map("stock")
  // @@schema("inventory")
}
