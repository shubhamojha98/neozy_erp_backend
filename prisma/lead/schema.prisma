generator client {
  provider = "prisma-client"
  output   = "../../generated/lead"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"

  schemas = ["lead"]
}

// ============================================================
// LEAD — enquiry jo abhi customer nahi bana
// companyId / assignedTo / createdBy → panel DB ke ids (company, user)
// ============================================================
enum LeadStatus {
  NEW
  FOLLOW_UP
  QUALIFIED
  CONVERTED
  LOST

  @@schema("lead")
}

enum LeadActivityType {
  CALL // call log (connected / not connected + outcome)
  NOTE
  STATUS // status badla
  ASSIGN // transfer
  CONVERT // customer bana

  @@schema("lead")
}

model Lead {
  id        Int    @id @default(autoincrement())
  companyId Int
  leadNo    String // LD000001 (company me unique)

  name            String
  phone           String
  alternateName   String?
  alternatePhone  String?
  email           String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  source          String // Website, Referral, ... (lib/constants.ts)
  status          LeadStatus @default(NEW)
  notes           String?
  lostReason      String? // Rejected / Duplicate / Wrong Number ...

  assignedTo       Int? // user id
  nextFollowupDate DateTime?
  lastContactedAt  DateTime?

  convertedCustomerId Int? // project.Customer.id
  convertedAt         DateTime?

  createdBy Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  activities LeadActivity[]

  @@unique([companyId, leadNo])
  @@index([companyId, status])
  @@index([companyId, phone])
  @@index([assignedTo])
  @@index([nextFollowupDate])
  @@map("leads")
  @@schema("lead")
}

// Timeline: call log, note, status change, transfer, convert
model LeadActivity {
  id        Int              @id @default(autoincrement())
  leadId    Int
  type      LeadActivityType
  connected Boolean? // CALL: phone utha ya nahi
  outcome   String? // CALL: Interested / Busy / ... , STATUS: naya status
  remarks   String?
  nextFollowupDate DateTime?

  createdBy Int
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_activities")
  @@schema("lead")
}
